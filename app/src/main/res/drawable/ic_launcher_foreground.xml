<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景层：引用位图资源 ic_nya_icon，四周 inset 16% 保证安全边距（
     Android 启动器会用圆形/圆角/水滴/方形等多种 mask 裁切，必须至少留 10% 以上边距，
     这里留 16% 让猫耳顶部、问号装饰、底部头发尾巴都不会被最激进的圆形裁切掉） -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_nya_icon"
    android:inset="16%" />
